# ============================================================
# Frontend 환경변수 예시
# 복사해서 사용: cp .env.example .env.local
# ============================================================
#
# ⚠️ Vite에서 VITE_ 접두사가 붙은 값은 빌드 시 브라우저 번들에 그대로 포함됩니다.
#    서버 전용 시크릿(Places API 키, OAuth 클라이언트 시크릿, DB 비밀번호)을
#    이 파일에 절대 넣지 마세요. 그것들은 backend/.env 에 있습니다.
#

# ── 백엔드 API ────────────────────────────────────────────
# 모든 데이터 요청은 이 주소를 경유합니다 (CLAUDE.md 2절).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Google Maps JavaScript API ────────────────────────────
# 용도: 지도 렌더링 전용. 노출을 전제로 한 키입니다.
# 필수 설정 (Google Cloud Console):
#   1. 애플리케이션 제한 → HTTP 리퍼러: http://localhost:5173/*, https://<배포도메인>/*
#   2. API 제한 → "Maps JavaScript API" 만 허용
#      ※ Places API 권한을 이 키에 부여하지 마세요. 프론트에서 Places를 직접 호출하면
#        정책·비용 문제가 발생합니다 (CLAUDE.md 3.1, 3.3절).
VITE_GOOGLE_MAPS_API_KEY=

# Cloud 기반 지도 스타일 ID (선택).
# 비어 있어도 기본 스타일로 지도는 뜹니다. 핀(AdvancedMarker) 작업에서 필요해집니다.
# 발급: Google Cloud Console → Map management → Create map ID (Vector, JavaScript)
VITE_GOOGLE_MAPS_MAP_ID=

# ── 지도 초기값 ───────────────────────────────────────────
# 싱가포르 중심 좌표 (기본 뷰포트)
VITE_MAP_DEFAULT_LAT=1.3521
VITE_MAP_DEFAULT_LNG=103.8198
VITE_MAP_DEFAULT_ZOOM=13

# 지도 이동/줌 시 /places/nearby 호출 디바운스 (ms) — CLAUDE.md 3.3절
VITE_MAP_DEBOUNCE_MS=400

# Cloudflare Turnstile 공개 site key (secret key를 넣지 마세요)
VITE_TURNSTILE_SITE_KEY=
