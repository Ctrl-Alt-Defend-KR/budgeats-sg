# 실제 값이 채워진 .env는 커밋하지 마세요.

# 서버
APP_ENV=local
PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# H2 파일 DB. 운영급 내구성이나 다중 인스턴스는 지원하지 않습니다.
DATABASE_URL=jdbc:h2:file:./data/budgeats;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=

# 서버 전용 시크릿. local 외 환경에서는 모두 필수입니다.
GOOGLE_PLACES_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:5173
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=604800

# local에서만 false를 허용합니다.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# 잠정 비즈니스 규칙. 팀 확정 후 값만 변경합니다.
PRICE_TIER_LOW_MAX_SGD=8
PRICE_TIER_MID_MAX_SGD=15
PRICE_ACTUAL_MIN_REVIEWS=3
REVIEW_CONTENT_MAX_LENGTH=1000
PLACES_NEARBY_DEFAULT_RADIUS_M=1500
REVIEW_RATE_LIMIT_PER_HOUR=10
