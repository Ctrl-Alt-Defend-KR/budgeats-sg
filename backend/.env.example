# ============================================================
# Backend 환경변수 예시
# 복사해서 사용: cp .env.example .env
# ============================================================
#
# ⚠️ 실제 값이 채워진 .env 는 절대 커밋하지 마세요.
#    CI의 gitleaks가 시크릿을 검출하면 빌드가 실패합니다 (CLAUDE.md 3.2절).
#

# ── 서버 ──────────────────────────────────────────────────
APP_ENV=local                              # local | staging | production
PORT=8000
LOG_LEVEL=info

# CORS 허용 오리진 (프론트엔드 주소). 쿠키 인증을 쓰므로 와일드카드(*) 금지.
FRONTEND_ORIGIN=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://budgeats:CHANGE_ME@localhost:5432/budgeats

# ── Google Places API (서버 전용) ─────────────────────────
# 이 키는 절대 프론트로 내려보내지 않습니다. 호출은 app/services/places 에서만.
# Google Cloud Console에서 IP 제한 + Places API 전용으로 설정하세요.
GOOGLE_PLACES_API_KEY=

# ── Google OAuth 2.0 ──────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# 로그인 성공 후 브라우저를 돌려보낼 프론트 주소
OAUTH_SUCCESS_REDIRECT=http://localhost:5173

# ── 세션 / 쿠키 ───────────────────────────────────────────
# 세션 서명 키. 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=604800             # 7일

# 토큰은 HttpOnly 쿠키로만 저장합니다 (CLAUDE.md 3.2절).
COOKIE_SECURE=false                        # ⚠️ 로컬 개발에서만 false. 운영은 반드시 true
COOKIE_SAMESITE=lax

# ── 비즈니스 규칙 상수 (매직 넘버 금지 — CLAUDE.md 8절) ──
# ⚠️ 아래 값은 잠정값입니다. CLAUDE.md 11절 미확정 항목 — 팀 확정 후 교체하세요.
PRICE_TIER_LOW_MAX_SGD=8                   # ~8 SGD  → 저가(초록)
PRICE_TIER_MID_MAX_SGD=15                  # 8~15    → 중가(노랑) / 초과 → 고가(빨강)
PRICE_ACTUAL_MIN_REVIEWS=3                 # 실측 평균 채택에 필요한 최소 리뷰 건수(N)

# 리뷰 본문 최대 길이 (CLAUDE.md 4절)
REVIEW_CONTENT_MAX_LENGTH=1000

# 위경도 캐시 TTL (일). Google 정책상 최대 30일 (CLAUDE.md 3.1절)
GEO_CACHE_TTL_DAYS=30

# 주변 검색 기본 반경 (m)
PLACES_NEARBY_DEFAULT_RADIUS_M=1500

# ── Rate Limiting (CLAUDE.md 3.2절) ───────────────────────
REVIEW_RATE_LIMIT_PER_HOUR=10
